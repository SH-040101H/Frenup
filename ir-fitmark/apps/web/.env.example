# Next.js Web Application Environment Configuration
# Copy this file to .env.local for local development

# Application Settings
NEXT_PUBLIC_APP_NAME=IR FitMark
NEXT_PUBLIC_APP_VERSION=1.0.0

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT=30000

# Authentication Configuration
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=ir-fitmark
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=ir-fitmark-web

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_SENTRY=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# File Upload Configuration
NEXT_PUBLIC_MAX_UPLOAD_SIZE=52428800
NEXT_PUBLIC_ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/avi
NEXT_PUBLIC_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Development Settings
NEXT_PUBLIC_DEVELOPMENT_MODE=true
NEXT_PUBLIC_SHOW_LOGS=true

# Analytics (Optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# Map Configuration (If needed)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key