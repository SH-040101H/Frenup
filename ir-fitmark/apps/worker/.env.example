# Python Worker Service Environment Configuration
# Copy this file to .env for local development

# Application Settings
APP_NAME=IR FitMark Worker
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ir_fitmark
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_ECHO=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DB=0

# S3/MinIO Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ir-fitmark
S3_REGION=us-east-1
S3_USE_SSL=false

# AI/ML Configuration
AI_MODEL_PATH=/models
AI_CONFIDENCE_THRESHOLD=0.8
AI_BATCH_SIZE=32
AI_MAX_VIDEO_DURATION=300
AI_PROVIDER=local
AI_DEVICE=cpu
AI_NUM_WORKERS=2

# External AI APIs (Optional)
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Worker Configuration
WORKER_CONCURRENCY=4
WORKER_PREFETCH_MULTIPLIER=1
WORKER_MAX_TASKS_PER_CHILD=1000

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=application/json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# Job Scheduling
ASSESSMENT_PROCESSING_INTERVAL=10
REPORT_GENERATION_INTERVAL=3600
CLEANUP_INTERVAL=86400
RETRY_DELAY=60
MAX_RETRIES=3

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/worker.log

# Performance Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090