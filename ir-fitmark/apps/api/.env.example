# FastAPI Backend Environment Configuration
# Copy this file to .env for local development

# Application Settings
APP_NAME=IR FitMark API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ir_fitmark
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_ECHO=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DB=0

# S3/MinIO Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ir-fitmark
S3_REGION=us-east-1
S3_USE_SSL=false

# Authentication Configuration
SECRET_KEY=your-super-secret-key-here-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ir-fitmark
KEYCLOAK_CLIENT_ID=ir-fitmark-api
KEYCLOAK_CLIENT_SECRET=ir-fitmark-api-secret

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# File Upload Configuration
MAX_UPLOAD_SIZE=52428800
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/avi
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# AI/ML Configuration
AI_MODEL_PATH=/models
AI_CONFIDENCE_THRESHOLD=0.8
AI_BATCH_SIZE=32
AI_MAX_VIDEO_DURATION=300
AI_PROVIDER=local
# OPENAI_API_KEY=your-openai-api-key-here

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json