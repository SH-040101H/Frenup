{
  "name": "@pkg/shared",
  "version": "1.0.0",
  "description": "Shared TypeScript types and constants for IR FitMark",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
