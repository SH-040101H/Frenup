# IR FitMark - Environment Configuration
# Copy this file to .env and update the values

# =============================================================================
# GENERAL SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ir_fitmark
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_ECHO=false

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DB=0

# =============================================================================
# S3/MINIO CONFIGURATION
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ir-fitmark
S3_REGION=us-east-1
S3_USE_SSL=false

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
SECRET_KEY=your-super-secret-key-here-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# KEYCLOAK CONFIGURATION
# =============================================================================
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ir-fitmark
KEYCLOAK_CLIENT_ID=ir-fitmark-api
KEYCLOAK_CLIENT_SECRET=ir-fitmark-api-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_PORT=8080

# =============================================================================
# AI/ML CONFIGURATION
# =============================================================================
AI_MODEL_PATH=/models
AI_CONFIDENCE_THRESHOLD=0.8
AI_BATCH_SIZE=32
AI_MAX_VIDEO_DURATION=300
AI_PROVIDER=local
# OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# APPLICATION PORTS
# =============================================================================
API_PORT=8000
WEB_PORT=3000
ADMIN_PORT=3001
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_WORKERS=1
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
MAX_UPLOAD_SIZE=52428800
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/avi
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=IR FitMark
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=ir-fitmark
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=ir-fitmark-web

# Admin Dashboard
NEXT_PUBLIC_ADMIN_KEYCLOAK_CLIENT_ID=ir-fitmark-admin

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1